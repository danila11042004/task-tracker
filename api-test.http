###Delete authorizationHeader from global variable
POST http://localhost:8080

> {%
    client.global.clear("authorizationHeader")
%}

###Registration with json request
POST http://localhost:8080/user
Content-Type: application/json

{
  "email": "danilatolstow@gmail.com",
  "password": "testPassword"
}

> {%
    client.global.set("authorizationHeader", response.headers.valueOf("Authorization"));
%}

###Login with json request
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "danilatolstow@gmail.com",
  "password": "testPassword"
}

> {%
    client.global.set("authorizationHeader", response.headers.valueOf("Authorization"));
%}

###Registration with form request
POST http://localhost:8080/user
Content-Type: application/x-www-form-urlencoded

email = test@mail &
password = testPassword

> {%
    client.global.set("authorizationHeader", response.headers.valueOf("Authorization"));
%}

###Login with form request
POST http://localhost:8080/auth/login
Content-Type: application/x-www-form-urlencoded

email = test@mail &
password = testPassword

> {%
    client.global.set("authorizationHeader", response.headers.valueOf("Authorization"));
%}

###Get current user
GET http://localhost:8080/user
Authorization: {{authorizationHeader}}

###Create new task current user
POST http://localhost:8080/tasks
Authorization: {{authorizationHeader}}
Content-Type: application/json

{
  "headline": "My six task",
  "textContent": "six text"
}

###Delete task current user
DELETE http://localhost:8080/tasks/10
Authorization: {{authorizationHeader}}

###Update task current user
PATCH http://localhost:8080/tasks/11
Authorization: {{authorizationHeader}}
Content-Type: application/json

{
  "status": "COMPLETED"
}